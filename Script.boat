_G.AntiAfk = true

-- Полностью отключаем кик на уровне настроек Roblox
pcall(function()
    local GC = getconnections or get_signal_cons
    if GC then
        for i, v in pairs(GC(game:GetService("Players").LocalPlayer.Idled)) do
            if v["Disable"] then v:Disable() elseif v["Disconnect"] then v:Disconnect() end
        end
    end
end)

-- Двойной фоновый кликер (работает даже при свернутой игре)
task.spawn(function()
    local VU = game:GetService("VirtualUser")
    game:GetService("Players").LocalPlayer.Idled:Connect(function()
        if _G.AntiAfk then
            VU:CaptureController()
            VU:ClickButton2(Vector2.new(0,0))
        end
    end)
    
    while true do
        task.wait(15) -- Кликает каждые 15 секунд для 100% надежности
        if _G.AntiAfk then
            pcall(function()
                VU:Button2Down(Vector2.new(0,0), workspace.CurrentCamera.CFrame)
                task.wait(0.1)
                VU:Button2Up(Vector2.new(0,0), workspace.CurrentCamera.CFrame)
            end)
        end
    end
end)
